# Cong truy cap tren may host (mo http://<ip>:PORT/admin)
PORT=3000

# IP LAN cua MAY HOST (container khong tu biet duoc) -> dung cho link trong ma QR
# Windows: ipconfig  |  Linux/Mac: ip addr / ifconfig
HOST_IP=192.168.1.10

# (Tuy chon) Neu co domain / tunnel thi dien link check-in day du, se uu tien hon HOST_IP
# PUBLIC_URL=https://checkin.example.com/checkin

# Tai khoan admin LAN DAU (sau do doi trong trang admin; doi o day khong co tac dung nua)
ADMIN_USER=admin
ADMIN_PASS=admin123

TZ=Asia/Ho_Chi_Minh
